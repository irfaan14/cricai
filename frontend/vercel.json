{
  "rewrites": [
    {
      "source": "/analytics/(.*)",
      "destination": "https://YOUR-RENDER-BACKEND.onrender.com/analytics/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR-RENDER-BACKEND.onrender.com/api/$1"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}